{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProfSynapse/talk-to-my-plant/contracts/telemetry.schema.json",
  "title": "Plant telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "recorded_at",
    "readings",
    "source"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
    "report_kind": { "enum": ["event", "checkin"], "default": "event" },
    "device_id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "source": { "enum": ["simulator", "hardware"] },
    "conditions": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10,
      "description": "Advisory only; server recomputes conditions from readings"
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_f",
        "humidity",
        "pressure_hpa",
        "battery_percent",
        "battery_voltage"
      ],
      "anyOf": [
        {
          "required": ["soil_moisture"],
          "properties": { "soil_moisture": { "type": "number" } }
        },
        { "required": ["soil_raw"] }
      ],
      "properties": {
        "soil_moisture": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Calibrated relative index; null until in-pot calibration exists" },
        "soil_raw": { "type": "integer", "minimum": 0, "maximum": 65535, "description": "Raw capacitive observation retained for calibration" },
        "temperature_f": { "type": "number", "minimum": -40, "maximum": 185 },
        "humidity": { "type": "number", "minimum": 0, "maximum": 100 },
        "pressure_hpa": { "type": "number", "minimum": 300, "maximum": 1100 },
        "battery_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "battery_voltage": { "type": "number", "minimum": 0, "maximum": 5 }
      }
    }
  }
}
