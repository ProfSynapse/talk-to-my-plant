# Copy this file to CIRCUITPY/settings.toml and replace the placeholders.
# Never commit the populated settings.toml file.

CIRCUITPY_WIFI_SSID = "YOUR_WIFI_NAME"
CIRCUITPY_WIFI_PASSWORD = "YOUR_WIFI_PASSWORD"

PLANT_DEVICE_ID = "plant-001"
PLANT_SENSOR_PLACEMENT = "bench_air"
PLANT_TELEMETRY_URL = "https://plant-api-production-68c9.up.railway.app/api/telemetry"
PLANT_API_KEY = "YOUR_HARDWARE_SCOPED_DEVICE_TOKEN"

# During initial in-pot calibration, retain one raw soil observation every
# fifteen minutes. Change this to false after thresholds are derived/deployed.
PLANT_CALIBRATION_MODE = true

# Wake, report, and power down the CPU, Wi-Fi, NeoPixel, and external STEMMA QT
# sensor rail between observations. Calibration records every fifteen minutes;
# normal operation records hourly. No manual watering trigger is required.
PLANT_DEEP_SLEEP_ENABLED = true
PLANT_CALIBRATION_INTERVAL_SECONDS = 900
PLANT_NORMAL_INTERVAL_SECONDS = 3600
